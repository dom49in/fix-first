# Copy to .env and fill in. Never commit .env. Secrets below are intentionally blank.

# The default is the real mode: Zetaris + Nightshift, both required.
# true  = offline testing only: read data/*.csv instead of Zetaris, and (only if no Nightshift credentials are set) use the
#         deterministic offline rules instead of a model. The weather file is SYNTHETIC. Outputs are labelled
#         sample_data / offline-rules.
SAMPLE_MODE=false

# --- Zetaris (data layer) ---------------------------------------------------------------------------
# From inside Docker use host.docker.internal instead of localhost.
# Two ways to reach Zetaris. If ZETARIS_BASE_URL is set the app uses the route Zetaris's own getting-started scripts use
# (the Zetaris UI address, e.g. http://localhost:3000, route /api/proxy/sql-editor/sqls/run-query). Otherwise it calls the REST API
# directly at ZETARIS_REST_URL. Use ONE; leave the other blank.
# Authenticate with ZETARIS_API_KEY (create it in the Zetaris GUI) or, for the proxy route, ZETARIS_USERNAME + PASSWORD.
ZETARIS_BASE_URL=
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
# ZETARIS_ENGINE_ID=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Source 1: DC Cityworks work orders: 2,041 active (FY2026) + 289 closed historical rows (record_set column), loaded by
# scripts/load_to_zetaris.py into the NEW container "fixfirst" (CC BY 4.0, see README)
ZETARIS_TABLE=fixfirst.work_orders
# Source 2: SLA policy, targets derived from the historical rows by scripts/derive_sla.py (weights are assumptions)
ZETARIS_POLICY_TABLE=fixfirst.sla_policy
# Source 3: US public holidays 2023-2026, a web API (Nager.Date) registered in Zetaris as REST tables. "none" switches it off.
ZETARIS_HOLIDAY_TABLE=fixfirst.us_holidays
# Source 4: daily weather 2023-2026, a web API (Open-Meteo) registered in Zetaris as a REST table. "none" switches it off.
ZETARIS_WEATHER_TABLE=fixfirst.weather_daily
# Row caps. The work set (~810 open orders) is fetched in one query, so keep ZETARIS_WORKSET_LIMIT above that.
ZETARIS_ROW_LIMIT=1000
ZETARIS_WORKSET_LIMIT=5000
# ZETARIS_TIMEOUT=60

# --- Pre-flight data check (runs before any agent) ---------------------------------------------------
# SELECT COUNT(1) on every table above. work_orders and sla_policy must be loaded; history, holidays and weather may be missing
# (the run continues, degraded, and says so) unless PREFLIGHT_REQUIRE_ALL=true.
# PREFLIGHT_REQUIRE_ALL=false
# PREFLIGHT_REQUIRE_POLICY=true

# --- Meterless Nightshift (primary AI provider) -----------------------------------------------------
# The app holds ONLY the Nightshift Runtime token. The NVIDIA key goes into Nightshift's Providers tab, never here.
# From inside Docker use http://host.docker.internal:8088/v1
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=fix-first

# --- Runtime ----------------------------------------------------------------------------------------
PORT=8000
LLM_TIMEOUT=60
MEMORY_DIR=.memory
# LOG_DIR=logs
# LOG_STDOUT=true        # JSONL trace lines are also printed to stdout; set false to silence
# MEMORY_ENABLED=true    # H-MEM on/off
# HMEM_THRESHOLD=0.25    # spec default is 0.35; see README "Deviations"

# Nightshift stops a lane that sends no first token in time (HTTP 504). The app sends header meterless-ttfb-ms
# (default 300000 = the maximum) on every call; lower it with LLM_TTFB_MS if you want.
LLM_TTFB_MS=300000
LLM_MAX_ATTEMPTS=3
# Optional extra headers, "name=value;name2=value2". Leave EMPTY unless you need one.
METERLESS_EXTRA_HEADERS=
# If a call gets a first-token 504, the next attempt uses this Nightshift mode instead (logged per call). Empty disables.
METERLESS_FALLBACK_MODEL=meterless/fast
